# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Group chat where completed applications are posted (bot must be an admin
# with permission to post messages/media there)
GROUP_CHAT_ID=-1002734287812

# Random string used to verify that webhook requests really come from
# Telegram. Generate your own with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=

# Added automatically when you run `vercel kv connect` / link a KV store to
# this project (do not set manually) — KV_REST_API_URL, KV_REST_API_TOKEN, etc.
