# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Group chat where completed applications are posted (bot must be an admin
# with permission to post messages/media there)
GROUP_CHAT_ID=-1002734287812

# Random string used to verify that webhook requests really come from
# Telegram. Generate your own with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=

# Neon Postgres connection string. Added automatically when you connect a
# Neon database to this project via Vercel (Storage -> Create Database ->
# Neon), or copy it from your Neon dashboard if you created it directly at
# neon.tech (recommended if the Vercel Marketplace asks for a payment method).
DATABASE_URL=

# Optional: key that protects the /api/applications admin page (list of
# submitted applications) and /api/photo. If not set, WEBHOOK_SECRET is
# used instead, so this only needs a value if you want a separate key.
ADMIN_SECRET=
